
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalkulator Aritmatika</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f8f9fa;
            font-family: Arial, sans-serif;
        }

        .kalkulator {
            max-width: 800px;
            margin: 80px auto;
            background-color: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

        .header {
            background-color: #0d6efd;
            color: white;
            text-align: center;
            padding: 20px;
        }

        .header h1 {
            font-size: 36px;
            margin-bottom: 10px;
        }

        .identitas {
            font-size: 22px;
            background-color: white;
            color: #4682b4;
            display: inline-block;
            padding: 3px 5px;
        }

        .isi {
            padding: 35px;
        }

        .form-label {
            font-size: 22px;
            margin-bottom: 12px;
        }

        .form-control,
        .form-select {
            font-size: 20px;
            padding: 12px;
            margin-bottom: 25px;
        }

        .btn-hitung {
            font-size: 22px;
            padding: 12px;
            width: 100%;
        }

        .hasil {
            background-color: #212529;
            color: white;
            text-align: center;
            padding: 30px;
            margin-top: 40px;
            border-radius: 8px;
        }

        .hasil h4 {
            font-size: 20px;
        }

        #hasilAngka {
            font-size: 70px;
            font-weight: bold;
            overflow-wrap: anywhere;
        }

        @media (max-width: 600px) {
            .kalkulator {
                margin: 20px 12px;
            }

            .header h1 {
                font-size: 28px;
            }

            .identitas {
                font-size: 16px;
            }

            .isi {
                padding: 20px;
            }
        }
    </style>
</head>

<body>

    <div class="container">
        <div class="kalkulator">

            <!-- Bagian Judul -->
            <div class="header">
                <h1>Kalkulator Aritmatika</h1>
                <div class="identitas">
                    Nadira Ayuni Iwanda - NIM. 262302001
                </div>
            </div>

            <!-- Bagian Input -->
            <div class="isi">

                <label for="angka1" class="form-label">
                    Angka Pertama
                </label>
                <input type="number" id="angka1"
                    class="form-control" placeholder="Masukkan angka pertama"
                    value="3" step="any">

                <label for="angka2" class="form-label">
                    Angka Kedua
                </label>
                <input type="number" id="angka2"
                    class="form-control" placeholder="Masukkan angka kedua"
                    value="5" step="any">

                <label for="operator" class="form-label">
                    Pilih Operator
                </label>
                <select id="operator" class="form-select">
                    <option value="+">Penjumlahan (+)</option>
                    <option value="-">Pengurangan (-)</option>
                    <option value="*">Perkalian (*)</option>
                    <option value="/">Pembagian (/)</option>
                    <option value="**" selected>Pangkat (**)</option>
                    <option value="%">Modulus (%)</option>
                </select>

                <!-- Tombol Hitung -->
                <button class="btn btn-primary btn-hitung"
                    onclick="hitung()">
                    Hitung
                </button>

                <!-- Bagian Hasil -->
                <div class="hasil">
                    <h4>HASIL PERHITUNGAN</h4>
                    <div id="hasilAngka">0</div>
                </div>

            </div>
        </div>
    </div>

    <!-- JavaScript -->
    <script>
        function hitung() {
            let angka1 = parseFloat(
                document.getElementById("angka1").value
            );

            let angka2 = parseFloat(
                document.getElementById("angka2").value
            );

            let operator = document.getElementById("operator").value;
            let hasil;

            if (
                document.getElementById("angka1").value === "" ||
                document.getElementById("angka2").value === ""
            ) {
                alert("Silakan masukkan kedua angka terlebih dahulu!");
                return;
            }

            switch (operator) {
                case "+":
                    hasil = angka1 + angka2;
                    break;

                case "-":
                    hasil = angka1 - angka2;
                    break;

                case "*":
                    hasil = angka1 * angka2;
                    break;

                case "/":
                    if (angka2 === 0) {
                        alert("Angka kedua tidak boleh 0 untuk pembagian!");
                        return;
                    }
                    hasil = angka1 / angka2;
                    break;

                case "**":
                    hasil = angka1 ** angka2;
                    break;

                case "%":
                    if (angka2 === 0) {
                        alert("Modulus dengan angka kedua 0 tidak bisa dilakukan!");
                        return;
                    }
                    hasil = angka1 % angka2;
                    break;

                default:
                    hasil = 0;
            }

            document.getElementById("hasilAngka").textContent =
                Number.isFinite(hasil)
                    ? Number(hasil.toPrecision(12)).toString()
                    : "Hasil tidak valid";
        }
    </script>

</body>
</html>
